# ============================================================================
# .env.example — profil `default` (bureau)
# Copier en `.env` dans ce meme dossier, puis remplir les valeurs.
# AUCUNE valeur reelle ne doit etre versionnee : ce fichier ne contient que des noms.
# ============================================================================

# --- Routeur LLM local (OmniRoute 127.0.0.1:20128) ---------------------------
# Cle OmniRoute du poste. Sert AUSSI de jeton d'administration (/api/keys) :
# le dashboard OmniRoute permet de creer une cle par profil, mais elle ne donne
# pas l'administration. Cle de reference de ce profil : voir ARCHITECTURE §1.
OMNIROUTE_API_KEY=

# --- Bot Telegram du profil default -----------------------------------------
# Un bot Telegram n'appartient qu'a UN profil : ne jamais recopier ce jeton
# dans profiles/watch/.env ou profiles/veille/.env (deux gateways sur un meme
# bot se neutralisent, et `hermes profile list` avertit d'un credential partage).
TELEGRAM_BOT_TOKEN=
# Ids numeriques des chats autorises (le proprietaire). Sans valeur : le bot
# ne repond a personne.
TELEGRAM_ALLOWED_USERS=
# Canal de livraison par defaut des jobs cron (`deliver: telegram`).
TELEGRAM_HOME_CHANNEL=

# --- Second cerveau SiYuan (127.0.0.1:6806) ---------------------------------
# Jeton d'API du workspace (Settings -> About -> API token dans SiYuan).
SIYUAN_TOKEN=
SIYUAN_URL=http://127.0.0.1:6806

# --- Providers LLM ----------------------------------------------------------
# Repli payant, dernier etage : ne se declenche qu'apres l'etage gratuit.
DEEPSEEK_API_KEY=
# Providers secondaires (vision, modeles de secours, NIM).
OPENROUTER_API_KEY=
KIMI_API_KEY=
NVIDIA_API_KEY_GEMMA4=

# --- Canal email du gateway (IMAP/SMTP) -------------------------------------
# Mot de passe d'APPLICATION (jamais le mot de passe du compte).
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=
# Expediteurs autorises a declencher l'agent par email.
EMAIL_ALLOWED_USERS=
# Intervalle de releve IMAP en secondes.
EMAIL_POLL_INTERVAL=

# --- Bridge WhatsApp (optionnel) --------------------------------------------
# WHATSAPP_ENABLED=true sans appairage laisse le gateway en erreur fatale :
# laisser vide/false si WhatsApp n'est pas utilise.
WHATSAPP_ENABLED=
WHATSAPP_MODE=
WHATSAPP_ALLOWED_USERS=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=

# --- Reglages techniques (valeurs de reference de cette installation) --------
TERMINAL_TIMEOUT=
TERMINAL_LIFETIME_SECONDS=
TERMINAL_MODAL_IMAGE=
BROWSER_SESSION_TIMEOUT=
BROWSER_INACTIVITY_TIMEOUT=
BROWSERBASE_PROXIES=
BROWSERBASE_ADVANCED_STEALTH=
WEB_TOOLS_DEBUG=
VISION_TOOLS_DEBUG=
MOA_TOOLS_DEBUG=
IMAGE_TOOLS_DEBUG=
