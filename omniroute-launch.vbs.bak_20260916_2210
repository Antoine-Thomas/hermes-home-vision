' OmniRoute auto-launch for Hermes — hidden window (no console flash)
Option Explicit
Dim sh, rc
Set sh = CreateObject("WScript.Shell")
' Idempotent: if port 20128 is already listening, do nothing.
rc = sh.Run("cmd /c netstat -an | findstr /r "":20128 "" >nul", 0, True)
If rc = 0 Then WScript.Quit 0
' Launch the daemon fully detached with a hidden window (0 = SW_HIDE, False = don't wait).
sh.Run """C:\Users\searc\AppData\Roaming\npm\omniroute.cmd"" serve --daemon --no-open", 0, False
