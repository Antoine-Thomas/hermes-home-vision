# ============================================================================
# .env.example — profil `veille`
# Copier en `.env` dans profiles\veille\, puis remplir les valeurs.
# Profil volontairement minimal : aucune reprise du .env du bureau.
# ============================================================================

# --- Routeur LLM local (OmniRoute 127.0.0.1:20128) ---------------------------
# Cle DEDIEE `hermes_veille` (7 modeles autorises, modele d'acces restreint).
OMNIROUTE_API_KEY=

# --- Bot Telegram du profil veille ------------------------------------------
# Bot PROPRE a ce profil (aucun autre profil ne doit porter ce jeton).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Canal de livraison du job hebdomadaire `veille-hebdo` (lundi 08h00).
TELEGRAM_HOME_CHANNEL=

# --- Second cerveau SiYuan (127.0.0.1:6806) ---------------------------------
# Le jeton est UNIQUE par workspace : il est donc partage avec le profil default
# (et avec SiYuan\hermes-projects\conf\conf.json). Une rotation se fait en un
# seul endroit (Reglages -> A propos) puis se repercute dans les deux .env.
SIYUAN_TOKEN=
SIYUAN_URL=http://127.0.0.1:6806

# ============================================================================
# Aucun autre bloc : ce profil ne doit PAS heriter des cles du bureau
# (pas de DEEPSEEK/OPENROUTER/KIMI/EMAIL/WHATSAPP). Ne jamais creer ce profil
# avec `hermes profile create veille --clone` ni `--clone-channels`.
# ============================================================================
