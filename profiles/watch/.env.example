# ============================================================================
# .env.example — profil `watch`
# Copier en `.env` dans profiles\watch\, puis remplir les valeurs.
# Profil isole : cle OmniRoute DEDIEE, bot Telegram DEDIEE.
# ============================================================================

# --- Routeur LLM local (OmniRoute 127.0.0.1:20128) ---------------------------
# Cle DEDIEE `hermes_watch` (modele d'acces restreint : 5 modeles autorises).
# Ne pas recopier la cle du bureau.
OMNIROUTE_API_KEY=

# --- Bot Telegram du profil watch -------------------------------------------
# Bot PROPRE a ce profil. Un bot ne peut appartenir qu'a un seul profil.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# --- Providers LLM ----------------------------------------------------------
# Repli : chaine gratuite d'abord (combo nvidia-stack / nemotron), payant en dernier.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
KIMI_API_KEY=
NVIDIA_API_KEY_GEMMA4=

# --- Bridge WhatsApp (optionnel) --------------------------------------------
WHATSAPP_ENABLED=
WHATSAPP_MODE=
WHATSAPP_ALLOWED_USERS=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=

# --- Reglages techniques ----------------------------------------------------
TERMINAL_TIMEOUT=
TERMINAL_LIFETIME_SECONDS=
TERMINAL_MODAL_IMAGE=
BROWSER_SESSION_TIMEOUT=
BROWSER_INACTIVITY_TIMEOUT=
BROWSERBASE_PROXIES=
BROWSERBASE_ADVANCED_STEALTH=
WEB_TOOLS_DEBUG=
VISION_TOOLS_DEBUG=
MOA_TOOLS_DEBUG=
IMAGE_TOOLS_DEBUG=

# ============================================================================
# PAS de bloc EMAIL_* ici, volontairement (decision du 17/09/2026).
# Les deux profils partageaient le mot de passe email du bureau : deux gateways
# releveraient la MEME boite IMAP, et `hermes profile list` avertissait d'un
# credential partage. Si `watch` doit traiter l'email un jour : lui donner une
# BOITE DISTINCTE (un second mot de passe d'application sur la meme boite ne
# change pas l'identite du canal).
# ============================================================================
