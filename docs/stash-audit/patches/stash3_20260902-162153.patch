diff --git a/agent/lsp/client.py b/agent/lsp/client.py
index 36c2721027..37b1d57f28 100644
--- a/agent/lsp/client.py
+++ b/agent/lsp/client.py
@@ -302,6 +302,13 @@ class LSPClient:
         exe = cmd[0]
         if exe.lower().endswith((".cmd", ".bat")):
             return ["cmd.exe", "/c", *cmd]
+        # An extension-less executable on Windows is an npm ``.bin`` POSIX
+        # shell script that CreateProcess cannot run (WinError 193). Resolve
+        # it to the ``.cmd`` sibling npm also emits and run that through cmd.
+        if sys.platform == "win32" and os.path.splitext(exe)[1] == "":
+            sibling = os.path.realpath(exe) + ".cmd"
+            if os.path.exists(sibling):
+                return ["cmd.exe", "/c", sibling, *cmd[1:]]
         return cmd
 
     async def _spawn(self) -> None:
